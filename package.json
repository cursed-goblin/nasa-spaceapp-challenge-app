{
  "name": "tradeoff-mission-design-lab",
  "private": true,
  "version": "0.3.0",
  "description": "TRADEOFF — a space mission design game for the NASA Space Apps Challenge 2026",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:check": "node scripts/check-resources.mjs",
    "data:check:strict": "node scripts/check-resources.mjs --strict",
    "qa": "node scripts/qa-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
